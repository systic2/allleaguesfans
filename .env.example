# .env.example
# --- Vite (Frontend) ---
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=public-anon-key

# --- Server/Scripts (Backend) ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE=service-role-key
SUPABASE_LOGO_BUCKET=logos

# --- Optional: Season Override ---
# Leave unset to default to the current calendar year (see src/lib/season.ts / src/lib/api.ts).
# Only set this to pin the app/scripts to a specific past season.
SEASON_YEAR=

# --- Optional: Monitoring & Alerts ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=your_sendgrid_key
FROM_EMAIL=noreply@yourdomain.com
ALERT_EMAIL=admin@yourdomain.com
