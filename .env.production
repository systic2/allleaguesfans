# .env.production - GitHub Actions Secrets에서 사용할 환경변수 목록

# 필수 환경변수 - 프론트엔드용 (GitHub Secrets에 설정 필요)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 필수 환경변수 - 백엔드/스크립트용 (GitHub Secrets에 설정 필요)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE=

# 기본값들 (변경시에만 Secrets 추가)
# SEASON_YEAR는 비워두면 현재 연도로 동적 계산됨 (src/lib/season.ts 참고). 과거 시즌 고정이 필요할 때만 값 지정.
SEASON_YEAR=
SUPABASE_LOGO_BUCKET=logos

# 선택적 환경변수 (알림 기능 사용시)
SLACK_WEBHOOK_URL=
EMAIL_SERVICE=
SENDGRID_API_KEY=
FROM_EMAIL=
ALERT_EMAIL=